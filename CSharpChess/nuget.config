<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 与 chess-cordis/drivers/nuget.config 同款：本机曾装 Visual Studio，其共享 NuGet
       回退文件夹（C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages）
       被注册为回退源但目录已不存在，导致 dotnet build 报 NU1301/MSB4018。此处清空全部
       回退文件夹，仅用 SDK 自带 targeting pack。作用域仅限本引擎目录（位置发现机制）。 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
