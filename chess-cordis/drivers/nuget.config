<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine used to have Visual Studio installed; its shared NuGet packages
       folder (C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages)
       was registered as a fallback source and now no longer exists, which makes
       `dotnet build` fail with NU1301 / MSB4018. Drop all fallback folders so the
       SDK's bundled targeting packs (and nuget.org when needed) are the only
       sources. Scoped to this drivers/ tree via location-based discovery. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
