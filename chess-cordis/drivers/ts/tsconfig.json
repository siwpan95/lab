{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "chess-cordis/drivers/ts/out"
  },
  "include": [
    "TsChess/chessCore.ts",
    "TsChess/chessAI.ts",
    "chess-cordis/drivers/ts/driver.ts"
  ]
}
